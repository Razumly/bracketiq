[Unit]
Description=Run BracketIQ due affiliate source scrapes
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/bracketiq/deploy/vm
Environment=COMPOSE_ENV_FILE=/opt/bracketiq/deploy/vm/deployment.env
ExecStart=/usr/bin/false
TimeoutStartSec=4h

[Install]
WantedBy=multi-user.target
