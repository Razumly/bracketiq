[Unit]
Description=Run BracketIQ affiliate source discovery and intake automation
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/bracketiq/legacy-affiliate-intake-enabled

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/bracketiq/deploy/vm
Environment=COMPOSE_ENV_FILE=/opt/bracketiq/deploy/vm/deployment.env
ExecStart=/usr/bin/false
TimeoutStartSec=20m

[Install]
WantedBy=multi-user.target
