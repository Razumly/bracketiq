# Every container image used in production must include an immutable sha256 digest.
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server@sha256:REPLACE_WITH_VERIFIED_DIGEST
EVALUATOR_IMAGE=ghcr.io/razumly/bracketiq-affiliate-agent@sha256:REPLACE_WITH_VERIFIED_DIGEST

# The model file must already exist under MODEL_DIRECTORY and match this hash.
MODEL_DIRECTORY=/var/lib/bracketiq-ai/models
MODEL_FILE=REPLACE_WITH_MODEL_FILE.gguf
MODEL_FILE_SHA256=REPLACE_WITH_64_HEX_SHA256
MODEL_ALIAS=REPLACE_WITH_MODEL_ALIAS
MODEL_MANIFEST_FILE=/etc/bracketiq-ai/model-manifest.json
MODEL_API_KEY_FILE=/etc/bracketiq-ai/model-api-key

MODEL_HOST_PORT=8080
MODEL_CONTEXT_SIZE=8192
MODEL_MAX_OUTPUT_TOKENS=2048
MODEL_THREADS=8
MODEL_THREADS_BATCH=8
MODEL_CACHE_TYPE_K=q8_0
MODEL_CACHE_TYPE_V=q8_0
MODEL_MEMORY_LIMIT=22g
MODEL_EVALUATION_TIMEOUT_MS=5400000

# The evaluator image is retained only for the credential-isolated evaluator
# profile; the former controller queue writer and its systemd units are retired.
AGENT_OUTPUT_DIRECTORY=/var/lib/bracketiq-ai/output

# Record the actual OVH order before enabling the evaluator profile.
OVH_ORDER_ID=REPLACE
OVH_ORDER_DATE=YYYY-MM-DD
OVH_REGION=REPLACE
OVH_IMAGE_ID=REPLACE
OVH_MONTHLY_PRICE_USD=REPLACE
OVH_RENEWAL_PRICE_USD=REPLACE
OVH_TAX_USD=REPLACE
OVH_DAILY_BACKUP_INCLUDED=REPLACE_WITH_true_OR_false
