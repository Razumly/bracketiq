# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim

ENV NODE_ENV=development \
  NEXT_TELEMETRY_DISABLED=1 \
  NODE_OPTIONS=--max-old-space-size=1536
WORKDIR /workspace/apps/site

RUN apt-get update \
  && apt-get install --no-install-recommends -y ca-certificates curl git openssh-client \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --system --gid 1001 bracketiq \
  && useradd --system --uid 1001 --gid bracketiq --home-dir /workspace bracketiq

COPY apps/site/package.json apps/site/package-lock.json ./
RUN npm ci \
  && npm cache clean --force

WORKDIR /workspace

COPY --chown=bracketiq:bracketiq . .

RUN git config --system --add safe.directory /workspace \
  && mkdir -p /var/lib/bracketiq-ai/worktrees /workspace/apps/site/output \
  && chown -R bracketiq:bracketiq /var/lib/bracketiq-ai/worktrees /workspace/apps/site/output

USER bracketiq

WORKDIR /workspace/apps/site

ENTRYPOINT ["/workspace/apps/site/deploy/ai/bin/run-controller-once.sh"]
