AFFILIATE_GOVERNED_PROJECT_NAME=bracketiq-affiliate-governed
AFFILIATE_AGENT_IMAGE=ghcr.io/razumly/bracketiq-affiliate-governed@sha256:REVIEWED_IMAGE_DIGEST
AFFILIATE_GATEWAY_IMAGE=ghcr.io/razumly/bracketiq-affiliate-gateway@sha256:REVIEWED_GATEWAY_IMAGE_DIGEST
# The reviewed PostgreSQL service is named postgres on the private backend network.
AFFILIATE_GATEWAY_DATABASE_URL=postgresql://bracketiq_app:REVIEWED_RUNTIME_PASSWORD@postgres:5432/bracketiq
AFFILIATE_GATEWAY_OPERATOR_TOKEN=__REPLACE_WITH_PRIVATE_REVIEWED_GATEWAY_OPERATOR_TOKEN__
# Dedicated cadence-only gateway credential. This is distinct from the operator
# token and is accepted only by POST <prefix>/replenishment.
AFFILIATE_GATEWAY_REPLENISHMENT_TOKEN=__REPLACE_WITH_PRIVATE_REVIEWED_GATEWAY_REPLENISHMENT_TOKEN__
# Dedicated supervisor-to-gateway halt credential. Keep this private, rotate it
# through the approved secret procedure, and never load it into the runner/Codex
# environment.
AFFILIATE_AGENT_SUPERVISOR_HALT_CREDENTIAL=__REPLACE_WITH_PRIVATE_REVIEWED_SUPERVISOR_HALT_CREDENTIAL__
# Use the existing reviewed production SMTP path until a dedicated mobile or
# webhook alert channel is approved.
AFFILIATE_OPERATIONAL_ALERT_EMAIL_TO=REVIEWED_OPERATIONAL_ALERT_EMAIL
SMTP_HOST=REVIEWED_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REVIEWED_SMTP_USER
SMTP_PASS=REVIEWED_SMTP_PASSWORD
SMTP_FROM=REVIEWED_SMTP_FROM
SMTP_FROM_NAME=BracketIQ
SMTP_SECURE=false
AFFILIATE_AGENT_TOKEN_SIGNING_KEY=REVIEWED_BASE64_TOKEN_SIGNING_KEY
AFFILIATE_GATEWAY_STORAGE_PROVIDER=spaces
AFFILIATE_GATEWAY_SPACES_ENDPOINT=REVIEWED_SPACES_ENDPOINT
AFFILIATE_GATEWAY_SPACES_REGION=REVIEWED_SPACES_REGION
AFFILIATE_GATEWAY_SPACES_BUCKET=REVIEWED_SPACES_BUCKET
AFFILIATE_GATEWAY_SPACES_KEY=REVIEWED_SPACES_KEY
AFFILIATE_GATEWAY_SPACES_SECRET=REVIEWED_SPACES_SECRET
AFFILIATE_SUPPLY_ROLLOUT_COHORT=DEFAULT
AFFILIATE_REPLENISHMENT_INTERVAL_SECONDS=900
AFFILIATE_AGENT_DEPLOYMENT_CONTRACT_JSON=REVIEWED_DEPLOYMENT_CONTRACT_JSON
AFFILIATE_AGENT_PREFLIGHT_REPORT_JSON=REVIEWED_CUTOVER_PREFLIGHT_REPORT_JSON
AFFILIATE_AGENT_TOKEN_KEY_VERSION=REVIEWED_TOKEN_KEY_VERSION
# Safe default for stopped container creation and inspection. After the gateway
# health/readiness gates pass and separate authorization, change this private
# value to unless-stopped for the persistent governed run.
AFFILIATE_AGENT_RESTART_POLICY=no
# Gateway and replenishment controller use the same reviewed non-root UID/GID.
AFFILIATE_GATEWAY_UID=1001
AFFILIATE_GATEWAY_GID=1001
# The shared workspace is a named local tmpfs volume, bounded to 2 GiB by
# compose.yml. Its root is supervisor-owned mode 0710; do not use a host bind.
AFFILIATE_GOVERNED_WORKSPACE_VOLUME=bracketiq-affiliate-governed-workspaces
# The runner and supervisors use the reviewed workspace identities.
AFFILIATE_AGENT_UID=1001
AFFILIATE_AGENT_RUNNER_CHILD_UID=1002
AFFILIATE_AGENT_RUNNER_CHILD_GID=1001
# Linux-only private cgroup v2 namespace. Engine 28+ uses
# writable-cgroups=true; the runner creates and verifies this relative subtree.
AFFILIATE_AGENT_RUNNER_CGROUP_RELATIVE_PATH=affiliate-agent-runner
AFFILIATE_AGENT_GID=1001
AFFILIATE_AGENT_GATEWAY_ADDRESS=http://affiliate-gateway.internal:8080
AFFILIATE_AGENT_GATEWAY_PATH_PREFIX=/v1/affiliate-agent
AFFILIATE_AGENT_CODEX_MODEL=gpt-5.6-luna
# Host path to the reviewed ChatGPT Codex auth.json. The runner mounts this
# file read-only and copies it into each fresh invocation CODEX_HOME.
AFFILIATE_AGENT_CODEX_AUTH_FILE=/home/bracketiq/.config/bracketiq-affiliate-agents/codex-auth.json
AFFILIATE_MAPPING_PRODUCER_1_RUNNER_PROTOCOL_PRIVATE_KEY=REVIEWED_BASE64_PKCS8_MAPPING_PRODUCER_1_RUNNER_PRIVATE_KEY
AFFILIATE_MAPPING_PRODUCER_2_RUNNER_PROTOCOL_PRIVATE_KEY=REVIEWED_BASE64_PKCS8_MAPPING_PRODUCER_2_RUNNER_PRIVATE_KEY
AFFILIATE_SUPPLY_REVIEWER_1_RUNNER_PROTOCOL_PRIVATE_KEY=REVIEWED_BASE64_PKCS8_SUPPLY_REVIEWER_1_RUNNER_PRIVATE_KEY
AFFILIATE_SUPPLY_REVIEWER_2_RUNNER_PROTOCOL_PRIVATE_KEY=REVIEWED_BASE64_PKCS8_SUPPLY_REVIEWER_2_RUNNER_PRIVATE_KEY
AFFILIATE_COVERAGE_PLANNER_RUNNER_PROTOCOL_PRIVATE_KEY=REVIEWED_BASE64_PKCS8_COVERAGE_PLANNER_RUNNER_PRIVATE_KEY
AFFILIATE_AGENT_RUNNER_PROTOCOL_PUBLIC_KEYS={"mapping-producer-1":"REVIEWED_BASE64_SPKI_MAPPING_PRODUCER_1_RUNNER_PUBLIC_KEY","mapping-producer-2":"REVIEWED_BASE64_SPKI_MAPPING_PRODUCER_2_RUNNER_PUBLIC_KEY","supply-reviewer-1":"REVIEWED_BASE64_SPKI_SUPPLY_REVIEWER_1_RUNNER_PUBLIC_KEY","supply-reviewer-2":"REVIEWED_BASE64_SPKI_SUPPLY_REVIEWER_2_RUNNER_PUBLIC_KEY","coverage-planner":"REVIEWED_BASE64_SPKI_COVERAGE_PLANNER_RUNNER_PUBLIC_KEY"}
AFFILIATE_AGENT_WORKSPACE_SIGNING_KEY=REVIEWED_BASE64_WORKSPACE_SIGNING_KEY
AFFILIATE_AGENT_GATEWAY_NETWORK=bracketiq_affiliate_gateway_internal
AFFILIATE_AGENT_GATEWAY_EGRESS_NETWORK=bracketiq_affiliate_gateway_egress
AFFILIATE_AGENT_PRODUCTION_BACKEND_NETWORK=bracketiq-production_backend
AFFILIATE_SCRAPINGDOG_API_KEY=REVIEWED_SCRAPINGDOG_API_KEY
AFFILIATE_FIRECRAWL_API_KEY=REVIEWED_FIRECRAWL_API_KEY
AFFILIATE_MAPPING_PRODUCER_1_CREDENTIAL=REVIEWED_MAPPING_PRODUCER_1_CREDENTIAL
AFFILIATE_MAPPING_PRODUCER_2_CREDENTIAL=REVIEWED_MAPPING_PRODUCER_2_CREDENTIAL
AFFILIATE_SUPPLY_REVIEWER_1_CREDENTIAL=REVIEWED_SUPPLY_REVIEWER_1_CREDENTIAL
AFFILIATE_SUPPLY_REVIEWER_2_CREDENTIAL=REVIEWED_SUPPLY_REVIEWER_2_CREDENTIAL
AFFILIATE_COVERAGE_PLANNER_CREDENTIAL=REVIEWED_COVERAGE_PLANNER_CREDENTIAL
AFFILIATE_HUMAN_DIRECTED_EXECUTOR_CREDENTIAL=REVIEWED_HUMAN_DIRECTED_EXECUTOR_CREDENTIAL
