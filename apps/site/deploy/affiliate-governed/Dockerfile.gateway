FROM node:22-bookworm-slim

ARG GATEWAY_UID=1001
ARG GATEWAY_GID=1001

RUN apt-get update \
  && apt-get install --no-install-recommends -y \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --gid "${GATEWAY_GID}" gateway \
  && useradd --uid "${GATEWAY_UID}" --gid "${GATEWAY_GID}" \
    --create-home --home-dir /home/gateway gateway

WORKDIR /workspace/apps/site

COPY package.json package-lock.json tsconfig.json ./
COPY prisma ./prisma
RUN npm ci --omit=dev

COPY src ./src
COPY scripts/normalize-prisma-generated.mjs scripts/normalize-prisma-generated.mjs
COPY scripts/run-affiliate-agent-gateway.ts scripts/run-affiliate-agent-gateway.ts
COPY scripts/run-affiliate-replenishment-controller.ts scripts/run-affiliate-replenishment-controller.ts
RUN npx prisma generate --schema prisma/schema.prisma \
  && node scripts/normalize-prisma-generated.mjs

ENV HOME=/tmp/gateway \
  PATH=/workspace/apps/site/node_modules/.bin:/usr/local/bin:/usr/bin:/bin \
  NODE_ENV=production

USER gateway
CMD ["tsx", "scripts/run-affiliate-agent-gateway.ts"]
