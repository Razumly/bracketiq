{
  "name": "bracketiq",
  "version": "1.0.0",
  "private": true,
  "description": "BracketIQ monorepo task runner",
  "scripts": {
    "build:site": "npm --prefix apps/site run build",
    "lint:site": "npm --prefix apps/site run lint",
    "test:site": "npm --prefix apps/site run test:ci",
    "typecheck:site": "npm --prefix apps/site exec -- tsc --noEmit",
    "test:mobile": "./apps/mobile/gradlew -p apps/mobile testDebugUnitTest --continue --stacktrace"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
